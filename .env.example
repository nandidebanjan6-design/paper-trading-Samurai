# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Cloud SQL Runtime Environment Variables (injected automatically in AI Studio / Cloud Run)
SQL_HOST="/cloudsql/instance-connection-name"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="placeholder_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="placeholder_admin_password"

# Market Data Provider Configuration (Optional - falls back to labeled Demo / Simulated Engine if unset)
MARKET_DATA_PROVIDER="FINNHUB"
MARKET_DATA_API_KEY=""

# Supabase / Vercel Compatibility Variables (for external Supabase + Vercel deployments)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
